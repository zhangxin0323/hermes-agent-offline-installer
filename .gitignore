# ===========================================================================
# 打包产物 —— 由 make-offline-package.sh 生成，体积以 GB 计，不入库
# ===========================================================================

# 目标机离线安装包
/dists/*/*.tar.gz
/dists/*/*.tar
/dists/*/*.zip

# 目标机安装脚本由发布页提供，仓库内保留的是打包脚本
# （如需把 install-offline-package.sh 纳入版本管理，删除下面一行）
# /dists/*/install-offline-package.sh

# ===========================================================================
# 打包输入 —— 在打包机上自动下载 / 手工放置，不属于源代码
# ===========================================================================

# Hermes Agent 上游源码包（hermes-agent-<版本>.zip）
/hermes-agent-*.zip
/*.zip.part

# latest 版本记录：记录“本机上次下载了哪个版本”，因人因机而异
/latest

# Node.js 官方预编译运行时
/node-*-linux-*.tar.xz
/node-*-linux-*.tar.gz

# uv 独立二进制
/uv-*-unknown-linux-gnu.tar.gz
/uv-*-unknown-linux-gnu/

# 沙箱基础镜像导出文件（python-3.12-slim-bookworm-arm64.tar 等）
/*.tar
/*.tar.xz

# 临时目录与本地工具
/.tmp/
/.tools/
/.cache/
*.part
*.download

# ===========================================================================
# 系统 / 编辑器噪声
# ===========================================================================

.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
